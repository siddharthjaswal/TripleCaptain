# Triple Captain — environment variables.
# Copy to `.env` and fill in. Everything except DATABASE_URL is optional; each
# integration stays inert until its keys are present, so the app runs without them.

# ── Database (required) ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/triplecaptain"

# ── Web Push notifications (optional) ───────────────────────────────
# Generate a keypair with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY are the SAME public key.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is inlined into the browser bundle at BUILD time,
# so it must be present before `pnpm build` runs.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:alerts@triplecaptain.in"

# ── AI narration (optional) ─────────────────────────────────────────
# Without a key the app falls back to the zero-token templated narrator.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-4-5"

# ── Google sign-in (optional) ───────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Auth.js v5 also needs a secret in production:  npx auth secret
AUTH_SECRET=""

# ── Logging (optional) ──────────────────────────────────────────────
# FPL_DEBUG_LOGS="true"
