generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id            String   @id @default(cuid())
  entryId       Int      @unique
  credits       Int      @default(5)
  isPro         Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Team {
  id           Int       @id
  name         String
  shortName    String
  code         Int
  awayFixtures Fixture[] @relation("AwayTeam")
  homeFixtures Fixture[] @relation("HomeTeam")
  players      Player[]
}

model Player {
  id                  Int      @id
  webName             String
  firstName           String?
  secondName          String?
  elementType         Int
  teamId              Int
  photo               String?
  epNext              Float?
  epThis              Float?
  form                Float?
  nowCost             Int
  selectedByPercent   Float?
  pointsPerGame       Float?
  minutes             Int      @default(0)
  chanceOfPlayingNext Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  team                Team     @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@index([elementType])
}

model Gameweek {
  id           Int       @id
  name         String
  deadlineTime DateTime
  finished     Boolean   @default(false)
  isCurrent    Boolean   @default(false)
  isNext       Boolean   @default(false)
  fixtures     Fixture[]
}

model Fixture {
  id          Int       @id
  gameweekId  Int?
  homeTeamId  Int
  awayTeamId  Int
  homeScore   Int?
  awayScore   Int?
  difficultyH Int?
  difficultyA Int?
  kickoffTime DateTime?
  finished    Boolean   @default(false)
  awayTeam    Team      @relation("AwayTeam", fields: [awayTeamId], references: [id])
  gameweek    Gameweek? @relation(fields: [gameweekId], references: [id])
  homeTeam    Team      @relation("HomeTeam", fields: [homeTeamId], references: [id])

  @@index([gameweekId])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model TeamAudit {
  id          String   @id @default(cuid())
  entryId     Int
  gameweek    Int
  healthScore Int
  critique    String
  suggestions Json
  createdAt   DateTime @default(now())

  @@index([entryId, gameweek])
}

model DifferentialPick {
  id             String   @id @default(cuid())
  playerId       Int
  gameweek       Int
  reasoning      String
  expectedPoints Float
  ownership      Float
  createdAt      DateTime @default(now())

  @@index([gameweek])
}
