generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// FPL-entry-keyed credits/pro state (anonymous users, pre-login era).
// Kept as the fallback; logged-in state lives on User. Mapped to the original
// "Account" table; the Auth.js OAuth model below owns the `Account` model name.
model FplAccount {
  id            String   @id @default(cuid())
  entryId       Int      @unique
  credits       Int      @default(5)
  isPro         Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("Account")
}

// ---------- Auth.js (Google login) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  entryId       Int?      @unique // linked FPL team
  isPro         Boolean   @default(false)
  credits       Int       @default(5)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}

model Team {
  id           Int       @id
  name         String
  shortName    String
  code         Int
  awayFixtures Fixture[] @relation("AwayTeam")
  homeFixtures Fixture[] @relation("HomeTeam")
  players      Player[]
}

model Player {
  id                  Int      @id
  webName             String
  firstName           String?
  secondName          String?
  elementType         Int
  teamId              Int
  photo               String?
  epNext              Float?
  epThis              Float?
  form                Float?
  nowCost             Int
  selectedByPercent   Float?
  pointsPerGame       Float?
  minutes             Int      @default(0)
  chanceOfPlayingNext Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  team                Team     @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@index([elementType])
}

model Gameweek {
  id           Int       @id
  name         String
  deadlineTime DateTime
  finished     Boolean   @default(false)
  isCurrent    Boolean   @default(false)
  isNext       Boolean   @default(false)
  fixtures     Fixture[]
}

model Fixture {
  id          Int       @id
  gameweekId  Int?
  homeTeamId  Int
  awayTeamId  Int
  homeScore   Int?
  awayScore   Int?
  difficultyH Int?
  difficultyA Int?
  kickoffTime DateTime?
  finished    Boolean   @default(false)
  awayTeam    Team      @relation("AwayTeam", fields: [awayTeamId], references: [id])
  gameweek    Gameweek? @relation(fields: [gameweekId], references: [id])
  homeTeam    Team      @relation("HomeTeam", fields: [homeTeamId], references: [id])

  @@index([gameweekId])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model TeamAudit {
  id          String   @id @default(cuid())
  entryId     Int
  gameweek    Int
  healthScore Int
  critique    String
  suggestions Json
  createdAt   DateTime @default(now())

  @@index([entryId, gameweek])
}

model DifferentialPick {
  id             String   @id @default(cuid())
  playerId       Int
  gameweek       Int
  reasoning      String
  expectedPoints Float
  ownership      Float
  createdAt      DateTime @default(now())

  @@index([gameweek])
}

model LeagueInsight {
  id        String   @id @default(cuid())
  leagueId  Int
  gameweek  Int
  insights  Json     // Array of {title, insight, squadName, sentiment}
  createdAt DateTime @default(now())

  @@unique([leagueId, gameweek])
  @@index([leagueId, gameweek])
}

model EliteSnapshot {
  id        String   @id @default(cuid())
  gameweek  Int      @unique
  sample    Int
  data      Json
  createdAt DateTime @default(now())
}
